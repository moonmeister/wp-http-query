<?xml version="1.0"?>
<ruleset name="WP HTTP QUERY">
	<description>WordPress Coding Standards and PHP 7.4+ compatibility for the feature plugin.</description>

	<!-- The plugin only. tests/fixtures is test scaffolding, never shipped. -->
	<file>plugin</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress"/>

	<config name="minimum_wp_version" value="7.2"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wp-http-query"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="WPHttpQuery"/>
				<element value="wp_http_query"/>
			</property>
		</properties>
	</rule>
</ruleset>
